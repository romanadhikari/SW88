# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SW88 Admin Bootstrap Credentials (configured on server-side only, never exposed in frontend)
SW88_ADMIN_USERNAME="sw88admin"
SW88_ADMIN_PASSWORD="ChangeMe_SW88Admin!"
SW88_SESSION_SECRET="replace-with-strong-random-secret"
