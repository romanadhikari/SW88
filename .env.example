# ==============================================================================
# SW88 Production & Local Environment Variables
# ==============================================================================

# Server Port (Render/Railway automatically inject PORT; defaults to 3000)
PORT=3000
NODE_ENV=production

# Persistent Storage Directory for SQLite DB, QR images, screenshots & APKs
# On Render/Railway with a mounted persistent volume, set e.g. /var/data
SW88_DATA_DIR="./data"

# Primary Admin Bootstrap Credentials (used ONLY if no ADMIN account exists yet)
SW88_ADMIN_USERNAME="sw88admin"
SW88_ADMIN_PASSWORD="ChangeMe_SW88Admin!"
SW88_SESSION_SECRET="replace-with-32-plus-char-random-secret"

# Public Frontend & CORS Origins (comma-separated for split Vercel + Backend deploys)
APP_URL="https://your-app.vercel.app"
CORS_ORIGINS="https://your-app.vercel.app"

# ==============================================================================
# Vercel Frontend Environment Variables (used at Vite build time)
# ==============================================================================
# Leave empty when frontend and backend share the same origin.
# Set to your Backend URL when hosting the frontend on Vercel (no trailing slash):
VITE_API_URL=""
# Optional custom WebSocket URL (derived automatically from VITE_API_URL if omitted):
VITE_WS_URL=""
